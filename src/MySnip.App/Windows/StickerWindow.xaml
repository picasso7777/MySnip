<Window x:Class="MySnip.App.Windows.StickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight">
  <Grid x:Name="StickerSurface" Margin="8">
    <Border x:Name="Frame" Background="Transparent" MinWidth="40" MinHeight="40">
      <Grid>
        <Image x:Name="StickerImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="ColorSample" Visibility="Collapsed" IsHitTestVisible="False"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="5,2"
                   Background="#DD202020" Foreground="White"/>
      </Grid>
    </Border>
    <Border x:Name="GlowOutline" BorderBrush="#AD589BFF" BorderThickness="1" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect x:Name="StickerGlow" Color="#3D8DFF" ShadowDepth="0" BlurRadius="9" Opacity="0.85"
                          RenderingBias="Quality"/>
      </Border.Effect>
    </Border>
  </Grid>
</Window>
